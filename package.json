{
  "name": "re-evented-org",
  "version": "1.0.0",
  "description": "Re-evented website",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint 'public_html/**/*.js' && stylelint 'public_html/**/*.css' && htmlhint 'public_html/**/*.html'",
    "test:run": "html-validate 'public_html/**/*.html'",
    "test:php": "bash tests/subscribe.test.sh",
    "build": "rm -rf dist && cp -r public_html dist && rm -f dist/README.md dist/subscribers.txt && npx tailwindcss -i src/tailwind.css -o dist/tailwind.css --minify && node scripts/hash-assets.mjs",
    "verify": "npm run lint && npm run test:run && npm run build",
    "test:tailwind": "bash tests/tailwind.test.sh",
    "test:hash": "node --test tests/hash-assets.test.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "html-validate": "^10.0.0",
    "htmlhint": "^1.1.4",
    "pa11y-ci": "^4.1.1",
    "serve": "^14.2.4",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "minimatch": "^9.0.7"
  }
}
