# Protect sensitive files from direct access
<Files "subscribers.txt">
    Order allow,deny
    Deny from all
</Files>

<Files "README.md">
    Order allow,deny
    Deny from all
</Files>

# Enable PHP processing
AddHandler application/x-httpd-php .php

# Set default character encoding
AddDefaultCharset UTF-8

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# HTML pages - short cache so updates are picked up quickly
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Service worker - never cache aggressively (browser must check for updates)
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </IfModule>
</Files>

# Set cache headers for static assets
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule> 
# Redirects for removed event pages
<IfModule mod_alias.c>
    Redirect 301 /events/atbru.html https://agiletourbrussels.be/
    Redirect 301 /events/less.html https://less.works/conferenza/conferences/2025-global-less-conference-amsterdam-13
    Redirect 301 /events/xpdays.html https://xpdaysbenelux.org/
    Redirect 301 /events/chris.html /#earlier-events
    Redirect 301 /events/reimagining-agility.html /#events
    Redirect 301 /events/certified-org-topologies-consultant.html /#events
    Redirect 301 /events/ebac-workshop.html /#events
    Redirect 301 /events/outcome-based-product-roadmaps.html /#events
</IfModule>
